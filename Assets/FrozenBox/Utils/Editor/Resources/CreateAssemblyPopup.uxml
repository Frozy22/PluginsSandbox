<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Label text="Creating Assembly" style="background-color: rgb(38, 38, 38); padding-top: 4px; padding-bottom: 4px; padding-left: 18px;" />
    <ui:VisualElement style="background-color: rgb(56, 56, 56); padding-top: 4px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; justify-content: center; border-top-width: 0; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(38, 38, 38); border-right-color: rgb(38, 38, 38); border-top-color: rgb(38, 38, 38); border-bottom-color: rgb(38, 38, 38);">
        <ui:TextField label="Namespace" placeholder-text="..." name="NameField" />
        <ui:Toggle label="Is Editor Assembly" name="IsEditorToggle" />
        <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: flex-start; align-self: auto; flex-grow: 1;">
            <ui:Button text="Create" name="CreateButton" style="height: 18px;" />
            <ui:Button text="Cancel" name="CancelButton" style="height: 18px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
